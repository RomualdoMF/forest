// import profiles and workflow SHA from core
includeConfig "base.config"

// define workflow params
params {

    help = false
    version = false
    // Path to a report.config file (see interactive_report/report.config, and
    // ReportConfig.generate in lib/ReportConfig.groovy, which writes one automatically
    // per run) -- launches interactive_report/report.py against it directly and skips
    // the rest of the pipeline entirely (see lib/ReportLauncher.groovy). None of the
    // usual pipeline inputs (--bam/--ref/--sample_name/...) are needed in this mode.
    report = null

    disable_ping = false
    threads = 28

    // Ceiling (GB) for every task.attempt-scaled memory retry in this pipeline --
    // see lib/MemoryScaling.groovy, used by mosdepth, dmr_calling, pileup_variants,
    // evaluate_candidates, aggregate_*_variants, post_clair_phase_contig,
    // post_clair_contig_haplotag, aggregate_all_variants, refine_with_sv,
    // phase_contig, run_tapes, merge_tapes, call_steller and callCNV. No process will
    // ever request more than this on a retry, however many attempts its own
    // maxRetries allows (each process' maxRetries is itself derived from this value
    // via MemoryScaling.retriesNeeded, so raising/lowering it also changes how many
    // times that process will retry). Override for a smaller/larger host, e.g.
    // --max_memory 64.
    max_memory = 128

    aws_image_prefix = null
    aws_queue = null

    // feature flags
    snv = true
    sv = true
    mod = true
    cnv = true
    str = true
    steller = false

    // benchmark feature flags
    sv_benchmark = false
    sv_benchmark_vcf = null
    sv_benchmark_bed = null

    // common
    bam = null
    ref = null
    bed = null
    coverage_bed = null
    bam_min_coverage = 20
    downsample_coverage = false
    downsample_coverage_target = 60
    downsample_coverage_margin = 1.1
    depth_window_size = 25000
    haplocheck = false
    mitogenome = null
    igv = false
    alignment_report_coverage_threshold = 20

    /// common
    ubam_map_threads = 10
    ubam_sort_threads = 10
    ubam_bam2fq_threads = 8

    // annotation
    annotation = true

    // fastVEP (https://github.com/Huang-lab/fastVEP, romualdomf/fastvep on Docker
    // Hub) annotation, replaces Ensembl VEP. --input/--output aren't configurable
    // here -- they're wired to the pipeline's own per-contig VCF channel (see
    // modules/local/vep.nf run_fastvep). --fasta likewise isn't a separate param:
    // it reuses the same reference already passed everywhere else in the
    // pipeline as params.ref (ref_channel).
    //
    // gff3/sa_dir point at externally-prepared fastVEP cache data (Ensembl GFF3
    // gene models + supplementary annotation .osa/.osa2 databases, built with
    // `fastvep sa-build` -- see the fastVEP README's "Build supplementary
    // annotation databases" section). Unlike the VEP cache this replaces, this
    // data is NOT auto-downloaded/auto-built by the workflow -- populate
    // /home/usuario/fastvep_cache/ yourself before running, and don't delete
    // anything in there between runs. Bind-mounted into the fastVEP container at
    // the same absolute host path (see base.config, withLabel:fastvep_annotation
    // containerOptions), same convention vep_cache_dir/vep_plugins_dir used
    // before.
    fastvep_gff3 = "/home/usuario/fastvep_cache/Homo_sapiens.GRCh38.115.gff3"
    fastvep_sa_dir = "/home/usuario/fastvep_cache/"
    // ACMG-AMP classification (Richards 2015 + ClinGen SVI), most-severe-consequence
    // transcript picking, and HGVSc/HGVSp notation are all on by default -- set any
    // of these false to match the old VEP+TAPES split more closely instead.
    fastvep_acmg = true
    fastvep_pick = true
    fastvep_hgvs = true
    fastvep_output_format = "vcf"

    // TAPES (https://github.com/RomualdoMF/tapes, fork of a-xavier/tapes patched for
    // dbNSFP5.x column compatibility) -- ACMG/AMP variant classification on top of the
    // VEP-annotated SNV VCF (needs --annotation, and the dbNSFP columns above to be
    // useful -- TAPES degrades gracefully with the plain VEP/ClinVar annotation alone,
    // but most ACMG criteria come from dbNSFP). Off by default; see
    // modules/local/tapes.nf and base.config withLabel:tapes.
    tapes = true

    // AnnotSV (https://github.com/lgmgeo/AnnotSV) -- structural variant
    // annotation/ranking, run on the VEP-annotated .sv.vcf.gz. Off by
    // default: needs the container image built+pushed (see
    // docker/annotsv/Dockerfile and its withLabel:annotsv container in
    // base.config) and a large (~5GB) annotation download on first use.
    annotsv = true
    // human annotation data directory, bind-mounted into the AnnotSV container
    // (see base.config, withLabel:annotsv containerOptions). Downloaded
    // automatically on first run if empty (see modules/local/annotsv.nf) and
    // reused afterwards -- same idea as fastvep_sa_dir above.
    annotsv_annotations_dir = "/home/usuario/AnnotSV/share/AnnotSV/"
    annotsv_human_annotations_version = "3.5"
    // extra raw AnnotSV CLI flags, one list per SV type annotated (see
    // modules/local/annotsv.nf run_annotsv) -- e.g. ["-hpo", "HP:0001156"].
    // NOTE: AnnotSV's native `-vcf 1` output is currently broken (produces a
    // header-only VCF, no records -- see the note in modules/local/annotsv.nf),
    // so it's deliberately *not* in either default below.
    annotsv_sv_custom_args = []
    annotsv_cnv_custom_args = []

    // CNV classification ensemble: ISV (tsladecek/isv_package) + ClassifyCNV
    // (Genotek/ClassifyCNV), run on top of AnnotSV's .cnv.annotsv.tsv (see
    // modules/local/cnv_ensemble.nf, bin/cnv_ensemble_classify.py). Off by
    // default; only meaningful when params.annotsv is also on, since it
    // consumes AnnotSV's output directly. Publishes <sample>.cnv.annotated.tsv
    // (AnnotSV+ISV+ClassifyCNV columns merged) and <sample>.cnv.annotated.vcf.gz
    // (same columns injected as INFO fields into the original .cnv.vcf.gz)
    // to the usual output dir, same as the rest of the CNV outputs.
    cnv_ensemble = true

    // snv
    override_basecaller_cfg = null
    clair3_model_path = null // used for overriding the guessed clair3 model
    // clair3 parameters
    sample_name = null
    ctg_name = null
    include_all_ctgs = false
    ref_pct_full = 0.1
    var_pct_full = 0.7
    GVCF = false
    base_err = 0.001
    gq_bin_size = 5
    snv_min_af = 0.08
    indel_min_af = 0.15
    vcf_fn = null
    min_contig_size = 0
    min_mq = 10
    min_cov = 5
    min_qual = 20
    // params.min_qual above looks like an output QUAL filter but isn't one --
    // it only reaches Clair3's CheckEnvs (an environment/provenance step), never
    // an actual filtering routine (confirmed on a real run: snv.vcf.gz had
    // FILTER=PASS on every record regardless of QUAL, min_mq/min_cov do reach
    // real calling routines). These two are a separate, explicit bcftools
    // QUAL/DP filter (see filter_snv_vcf_by_qual_dp in
    // modules/local/wf-human-snv.nf) applied to Clair3's raw SNV VCF before
    // annotation, independent of --annotation.
    vcf_snv_min_qual = 20
    vcf_snv_min_dp = 10
    refine_snv_with_sv = true

    // sv
    tr_bed= null
    // filterCalls
    min_sv_length = 30
    min_read_support = "auto"
    min_read_support_limit = 5
    // sniffles2 options
    cluster_merge_pos = 150
    sniffles_args = null

    // qdnaseq cnv
    use_qdnaseq = false
    qdnaseq_bin_size = 500

    // spectre cnv
    spectre_args = "--min-cnv-len 30000"

    // mod
    modkit_args = null
    force_strand = false
    modkit_threads = 8

    // DMR (Differentially Methylated Region) calling, via ont-methylDMR-kit's
    // DSS/bsseq core (https://github.com/NyagaM/ont-methylDMR-kit, commit
    // dcbc3da31db19f477194cdd33ebc3001554f888e -- see workflows/dmr.nf /
    // modules/local/dmr.nf). Both opt-in, off by default, and both require
    // params.mod. Runs DSS for 5mC and 5hmC (whatever workflows/methyl.nf's own
    // modkit invocation produces).
    //
    // Haplotype 1 vs haplotype 2 of the same sample -- only meaningful with
    // --phased (needs H1/H2 bedmethyl).
    dmr_haplotype_compare = true
    // The sample vs an external reference: a BAM/CRAM (piled up here) or an
    // already-built bedmethyl -- detected by file extension (see
    // workflows/dmr.nf::dmr_sample_compare).
    dmr_sample_compare = false
    dmr_sample_compare_reference = null
    // Literal subset of upstream ont-methylDMR-kit's own CLI flags this
    // integration understands, one list per comparison. Annotation
    // (gencode/imprinted) and the HTML report always run once DMRs are called
    // (same as upstream -- they aren't optional there either); only plotting is
    // gated by these. Default includes "--plot" (full pipeline, as requested):
    // pass a shorter/empty list to skip plotting for that comparison.
    // Recognised flags: --plot, --methylartist_only, --gene_list <path>, --imprinted.
    dmr_haplotype_compare_args = ["--plot"]
    dmr_sample_compare_args = ["--plot"]
    // gencode v46 promoter/exon/intron BED + imprinted gene list + gencode GTF
    // (for plotting), downloaded once from the pinned ont-methylDMR-kit commit
    // above into this directory (idempotent, same pattern as
    // fastvep_sa_dir/annotsv_annotations_dir -- see download_dmr_annotations in
    // modules/local/dmr.nf).
    dmr_annotations_dir = "/home/usuario/ont-methylDMR-kit/annotations"

    //str
    sex = null
    // STR (Short Tandem Repeat) genotyping: straglr genotypes the loci listed
    // in str_repeat_bed, then Stranger annotates the resulting VCF against
    // str_variant_catalog (see modules/local/wf-human-str.nf). Defaults point
    // at STRchive's (https://github.com/dashnowlab/STRchive) pre-built hg38
    // catalogs -- a straglr-format BED and a Stranger-format JSON, both
    // published by STRchive itself as schema-compatible drop-ins for these
    // exact tools -- replacing the small 52-locus GeneReviews-only catalog
    // forest originally shipped (data/wf_str_repeats.bed /
    // data/variant_catalog_hg38.json, left in the repo for reference but no
    // longer used by default). Override both to point at your own BED/JSON
    // to use a different catalog.
    str_repeat_bed = "${projectDir}/data/STRchive-disease-loci.hg38.straglr.bed"
    str_variant_catalog = "${projectDir}/data/STRchive-disease-loci.hg38.stranger.json"

    // sTELLeR (https://github.com/KristineBilgrav/sTELLeR) -- calls non-reference
    // transposable element (Alu/L1/SVA/HERV) insertions from long-read alignments.
    // Replaces tldr as this pipeline's transposable-element insertion caller. Runs
    // per-contig against the same intermediate haplotagged BAMs straglr already
    // consumes (see workflows/wf-human-snv.nf, the `str_bams` emit -- per-contig,
    // produced before the final whole-genome BAM merge), one steller invocation per
    // contig (modules/local/steller.nf), published per-contig -- unlike tldr there is
    // no merge into one whole-sample file (see modules/local/steller.nf for why: each
    // per-contig VCF's sample column is literally that invocation's -o prefix, so a
    // naive concat would leave every contig with a different, mismatched sample-column
    // name). Requires haplotagging, same as --str: turning --steller on by itself is
    // enough to trigger it (see main.nf, run_haplotagging), no need to also pass
    // --phased.
    //
    // -R/--ref, -b/--bam, -o/--output are NOT exposed as params -- wired internally by
    // the pipeline (the same ref_channel used everywhere else, the per-contig BAM
    // channel, and a deterministic "<alias>.<contig>_steller" prefix). --style is
    // always "ont" -- hardcoded in modules/local/steller.nf, not a param, since this
    // pipeline only ever processes ONT data.
    steller_sr = 5
    steller_mq = 20
    steller_maxreads = 80
    // fasta of transposable element sequences to detect (steller's -tf/--TE_fasta) --
    // unlike tldr's -e/--elts, steller ships no bundled TE reference inside its image,
    // so this has no in-container default -- it's a real host path, staged into each
    // task like any other Nextflow `path` input (see modules/local/steller.nf).
    // Override to point at your own TE fasta.
    steller_TE_fasta = "/home/usuario/tools/steller/TEsequences_SVA_HERV_ALU_L1.fasta"

    // output
    depth_intervals = true
    phased = true
    output_report = true
    output_xam_fmt = "bam"

    // Integrations
    partner = null

    // nfcore
    monochrome_logs = false
    validate_params = true
    show_hidden_params = false
    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,wf,min_read_support,min_read_support_limit,fastq_only'

    store_dir = null

    wf {
        name = "forest"
        template_version = "195cab5"
        example_cmd = [
            "--bam 'path/to/SAMPLE.bam'",
            "--ref 'path/to/reference.fasta'",
            "--sample_name 'SAMPLE'"
        ]
        agent = null
    }
}

// this process is inherited from wf-template, which specifies not many CPUs as a conservative baseline.
process {
    withName:mergeBams {
        cpus = 8
    }
    // Upstream (lib/_ingress.nf) declares `(32.GB * task.attempt) - 1.GB` = 31GB on the
    // first attempt. That's a hard scheduling-time requirement check against the local
    // executor's total detected capacity (not an enforced container memory cap -- this
    // pipeline's docker invocations don't pass -m/--memory), so on any host with less
    // than 32GB total RAM (this dev machine: 30.6GB under WSL2) Nextflow refuses to ever
    // schedule the task at all and the whole run aborts. Fixed (not task.attempt-scaled)
    // override well under the real ceiling -- retrying with an even bigger declared
    // requirement wouldn't help on a host that's already at its RAM limit.
    withName:minimap2_alignment {
        memory = { 64.GB }
        maxRetries = 0
    }
}

manifest {
    name            = 'forest'
    author          = 'RomualdoMF'
    homePage        = 'https://github.com/RomualdoMF/forest'
    description     = 'SNV calling, SV calling, modified base calling, CNV calling, and STR genotyping of human samples.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = '2.8.1'
}

epi2melabs {
    tags = "forest,variant calling,whole genome,human"
    icon = "faIdCard"
}

